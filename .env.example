# Copier ce fichier en .env (jamais committe). Le .env est lu au demarrage.

# --- Notifications Telegram (optionnel) ---
# Bot: @BotFather -> /newbot. Chat id: envoyer un message au bot puis ouvrir
# https://api.telegram.org/bot<TOKEN>/getUpdates et lire "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Pont Windows -> Kali (obligatoire seulement si data.provider: bridge) ---
# Generer: python bot.py bridge --host 0.0.0.0 --port 8765
# Le jeton affiche au premier demarrage est a recopier ici et dans .env cote Kali.
GOLDBOT_BRIDGE_TOKEN=

# --- Compte MT5 (inutile via le pont: le terminal deja connecte fournit tout) ---
MT5_PASSWORD=
